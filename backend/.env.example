MONGO_URI=mongodb://localhost:27017
USE_MOCK_MONGO=true

AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# --- Phase 9: Java test execution (secure containerized runner) ---
# Execution is DISABLED by default. Generated/user-provided Java is never
# executed on the host: it is compiled and run inside a fixed container
# image with no network, read-only filesystem, non-root user, and
# CPU/memory/process limits. See README, Phase 9.
ENABLE_JAVA_EXECUTION=false
# Fixed, application-controlled runner image (must exist locally).
EXECUTION_IMAGE=eclipse-temurin:21-jdk
# JUnit Platform Console Standalone jar used to run JUnit 5 tests.
JUNIT_CONSOLE_JAR=backend/.tools/junit-platform-console-standalone-1.10.2.jar
# Timeouts (seconds): compilation step, then the whole test run.
EXECUTION_COMPILE_TIMEOUT_SECONDS=90
EXECUTION_TIMEOUT_SECONDS=120
